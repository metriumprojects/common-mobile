{
  "name": "common",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "eas build -p android --profile preview --local",
    "build:production": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "submit:ios": "eas submit -p ios --latest",
    "build:list": "eas build:list",
    "build-android": "cd android && gradlew assembleDebug && cd ../",
    "assemble-release": "cd android && gradlew.bat clean assembleRelease",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.1",
